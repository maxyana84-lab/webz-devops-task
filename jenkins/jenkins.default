# /etc/default/jenkins - settings for /etc/init.d/jenkins
JENKINS_USER=jenkins
JENKINS_HOME=/var/lib/jenkins
JENKINS_WAR=/usr/share/java/jenkins.war
JENKINS_LOG=/var/log/jenkins/jenkins.log
JENKINS_PIDFILE=/var/run/jenkins.pid
HTTP_PORT=8080
# Heap limited: the whole stack must fit on small machines (tested on a 3 GB WSL VM)
JAVA_OPTS="-Xms256m -Xmx512m -Djava.awt.headless=true -Djenkins.install.runSetupWizard=false"
