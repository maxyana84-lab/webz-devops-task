#!/bin/bash
### BEGIN INIT INFO
# Provides:          jenkins
# Required-Start:    $remote_fs $network
# Required-Stop:     $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Jenkins automation server
### END INIT INFO
# SysV init script: `service jenkins start|stop|restart|status`

# shellcheck source=/dev/null  # file exists only inside the image
. /etc/default/jenkins
TZ_OPT="-Duser.timezone=${TZ:-UTC}"

is_running() {
    [ -f "$JENKINS_PIDFILE" ] && kill -0 "$(cat "$JENKINS_PIDFILE")" 2>/dev/null
}

case "$1" in
    start)
        if is_running; then echo "jenkins is already running"; exit 0; fi
        echo "Starting jenkins on port $HTTP_PORT"
        start-stop-daemon --start --background --make-pidfile --pidfile "$JENKINS_PIDFILE" \
            --chuid "$JENKINS_USER" --chdir "$JENKINS_HOME" \
            --startas /bin/bash -- -c \
            "export JENKINS_HOME=$JENKINS_HOME TZ=${TZ:-UTC}; exec java $JAVA_OPTS $TZ_OPT -jar $JENKINS_WAR --httpPort=$HTTP_PORT >> $JENKINS_LOG 2>&1"
        ;;
    stop)
        echo "Stopping jenkins"
        start-stop-daemon --stop --pidfile "$JENKINS_PIDFILE" --retry TERM/30/KILL/5 --remove-pidfile
        ;;
    restart)
        "$0" stop; "$0" start
        ;;
    status)
        if is_running; then echo "jenkins is running (pid $(cat "$JENKINS_PIDFILE"))"; exit 0
        else echo "jenkins is not running"; exit 3; fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"; exit 1
        ;;
esac
